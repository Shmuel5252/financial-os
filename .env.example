# Copy this file to .env.local for local development. Never commit real values.
# Generate AUTH_SECRET with a cryptographically secure 32-byte-or-longer value.
AUTH_SECRET=<generate-a-random-secret-of-at-least-32-characters>
AUTH_URL=http://localhost:3001
# Optional metadata-only readiness operators: comma-separated environment-local
# Auth.js user IDs. Empty/malformed denies all. Configure privately; not a token.
OPERATIONS_OPERATOR_USER_IDS=
# Optional explicit operational classification. This does not grant permissions.
# Set staging only in the dedicated staging environment; no inference from VERCEL_ENV.
FINANCIAL_OS_ENVIRONMENT=local
# Optional deployment-only operational brakes. No public control API.
# Unset/false preserves behavior; true (or malformed nonempty) disables.
OPERATIONS_DISABLE_AI=false
OPERATIONS_DISABLE_BANK_REFRESH=false
OPERATIONS_DISABLE_EMAIL=false
# Register http://localhost:3001/api/auth/callback/google for local Google OAuth.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# MongoDB application database. Use a least-privilege database user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=financial_os_development

# Optional isolated database used only by integration tests.
MONGODB_TEST_URI=<isolated-mongodb-test-uri>
MONGODB_TEST_DB_NAME=financial_os_integration

# Server-only AI adapter. The key is required only when the copilot is invoked.
ANTHROPIC_API_KEY=<anthropic-api-key>
# Required only for an identity-linked key that is not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=<anthropic-workspace-id>
ANTHROPIC_MODEL=claude-haiku-4-5

# Server-only notification adapter. Use a verified sender for production delivery.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Financial OS <notifications@your-verified-domain.example>

# Server-only Financy / Open-Finance.ai financial-data adapter.
# Connections are created through Financy's hosted consent UI. Access tokens
# are short-lived and kept in process memory; no webhook secret is accepted.
OPEN_FINANCE_USER_ID=<financy-end-user-id>
OPEN_FINANCE_CLIENT_ID=<financy-client-id>
OPEN_FINANCE_CLIENT_SECRET=<financy-client-secret>
