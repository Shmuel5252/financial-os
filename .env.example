# Copy this file to .env.local for local development. Never commit real values.
# Generate AUTH_SECRET with a cryptographically secure 32-byte-or-longer value.
AUTH_SECRET=<generate-a-random-secret-of-at-least-32-characters>
AUTH_URL=http://localhost:3001
# Register http://localhost:3001/api/auth/callback/google for local Google OAuth.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# MongoDB application database. Use a least-privilege database user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=financial_os_development

# Optional isolated database used only by integration tests.
MONGODB_TEST_URI=<isolated-mongodb-test-uri>
MONGODB_TEST_DB_NAME=financial_os_integration

# Server-only AI adapter. The key is required only when the copilot is invoked.
ANTHROPIC_API_KEY=<anthropic-api-key>
# Required only for an identity-linked key that is not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=<anthropic-workspace-id>
ANTHROPIC_MODEL=claude-haiku-4-5

# Future server-only Open Banking adapter.
OPEN_BANKING_PROVIDER=<licensed-provider-identifier>
OPEN_BANKING_CLIENT_ID=<open-banking-client-id>
OPEN_BANKING_CLIENT_SECRET=<open-banking-client-secret>
OPEN_BANKING_WEBHOOK_SECRET=<open-banking-webhook-secret>
